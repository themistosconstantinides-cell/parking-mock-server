<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <EditText
            android:id="@+id/edtOutlet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Outlet Number"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edtTerminal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Terminal Number"
            android:inputType="text"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edtUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Server URL"
            android:inputType="textUri"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/edtPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Show Rates on Screen (1=Yes, 0=No)"
            android:inputType="number"
            android:text="1"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SAVE"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnInit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="INIT"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/progressInit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtInitStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONTINUE"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnVehiclePresent"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VEHICLE PRESENT: YES"
            android:backgroundTint="#238636"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnExitScenario"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="EXIT SCENARIO: 3 - TopUp Needed"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLogs"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VIEW LOGS"
            android:layout_marginBottom="8dp"/>

    </LinearLayout>
</ScrollView>