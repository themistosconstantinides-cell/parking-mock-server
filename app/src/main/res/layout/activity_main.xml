<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:background="#161B22"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/txtHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PARKING TERMINAL"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:letterSpacing="0.12"
            android:textAllCaps="true" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@android:drawable/ic_menu_manage"
            android:tint="#8B949E"
            android:padding="10dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <View
        android:id="@+id/divTop"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#21262D"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toBottomOf="@id/divTop"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <!-- P Icon -->
            <LinearLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:background="@drawable/circle_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="P"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#1F6FEB" />
            </LinearLayout>

            <!-- Welcome message -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:gravity="center"
                android:lineSpacingMultiplier="1.25"
                android:layout_marginBottom="16dp" />

            <!-- Info card -->
            <LinearLayout
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#C9D1D9"
                    android:lineSpacingMultiplier="1.6"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM AREA -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D1117"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D"
            android:layout_marginBottom="14dp"/>

        <!-- Select to continue label -->
        <TextView
            android:id="@+id/txtSelectPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select to continue"
            android:textSize="13sp"
            android:textColor="#8B949E"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:layout_marginBottom="14dp"/>

        <!-- Circle buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <!-- BANK CARD circle -->
            <LinearLayout
                android:id="@+id/btnContinueWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btnContinue"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:text="💳"
                    android:textSize="32sp"
                    android:backgroundTint="#1F6FEB"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_blue" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BANK CARD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#C9D1D9"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- MONTHLY CARD circle -->
            <LinearLayout
                android:id="@+id/btnMonthlyWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="40dp"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnMonthly"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:text="🪪"
                    android:textSize="32sp"
                    android:backgroundTint="#238636"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_green" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTHLY CARD"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#C9D1D9"
                    android:layout_marginTop="8dp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <!-- HELP -->
        <Button
            android:id="@+id/btnHelp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="HELP"
            android:textSize="12sp"
            android:textColor="#8B949E"
            android:backgroundTint="#161B22"
            android:stateListAnimator="@null" />

        <!-- LOADER -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            android:indeterminateTint="#1F6FEB" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>