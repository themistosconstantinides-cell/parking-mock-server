<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <!-- Settings icon top-right — invisible, 5 taps to open Settings -->
    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@android:drawable/ic_menu_manage"
        android:tint="#30363D"
        android:padding="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomCard"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- P Icon + Language button side by side -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:id="@+id/btnPIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:background="@drawable/circle_bg">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1F6FEB" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLang"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="🌐 EN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#30363D"
                    android:stateListAnimator="@null"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="10dp"/>

            </LinearLayout>

            <!-- Welcome message -->
            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp" />

            <!-- Info card -->
            <LinearLayout
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:id="@+id/txtInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="14sp"
                    android:textColor="#C9D1D9"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM AREA -->
    <LinearLayout
        android:id="@+id/bottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0D1117"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#21262D"
            android:layout_marginBottom="8dp"/>

        <!-- Tap to continue label - bigger -->
        <TextView
            android:id="@+id/txtSelectPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tap to continue"
            android:textSize="16sp"
            android:textColor="#8B949E"
            android:gravity="center"
            android:letterSpacing="0.05"
            android:layout_marginBottom="10dp"/>

        <!-- Circle buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="8dp">

            <!-- BANK CARD circle - bigger -->
            <LinearLayout
                android:id="@+id/btnContinueWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <Button
                    android:id="@+id/btnContinue"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:text="💳"
                    android:textSize="40sp"
                    android:backgroundTint="#1F6FEB"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_blue" />
                <TextView
                    android:id="@+id/txtBankCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BANK CARD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#C9D1D9"
                    android:layout_marginTop="10dp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- MONTHLY CARD circle - bigger -->
            <LinearLayout
                android:id="@+id/btnMonthlyWrap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginStart="48dp"
                android:visibility="gone">
                <Button
                    android:id="@+id/btnMonthly"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:text="🪪"
                    android:textSize="40sp"
                    android:backgroundTint="#238636"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_green" />
                <TextView
                    android:id="@+id/txtMonthlyCardLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MONTHLY CARD"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#C9D1D9"
                    android:layout_marginTop="10dp"
                    android:gravity="center"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Bottom row: INFO bottom-left, HELP bottom-right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <!-- INFO button bottom-left -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btnInfo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="i"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1F6FEB"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_bg"
                    android:padding="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INFO"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#1F6FEB"
                    android:layout_marginTop="4dp"
                    android:gravity="center"/>

            </LinearLayout>

            <!-- Spacer — 5 taps to open Settings -->
            <View
                android:id="@+id/tapZone"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"/>

            <!-- HELP button bottom-right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <Button
                    android:id="@+id/btnHelp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="?"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#E65100"
                    android:stateListAnimator="@null"
                    android:background="@drawable/circle_bg"
                    android:padding="0dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HELP"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginTop="4dp"
                    android:gravity="center"/>

            </LinearLayout>
        </LinearLayout>

        <!-- LOADER -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:indeterminateTint="#1F6FEB" />

    </LinearLayout>

    <!-- MONTHLY CARD OVERLAY — camera preview top + keypad bottom -->
    <LinearLayout
        android:id="@+id/keypadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EE0D1117"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header row with title and X cancel button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A2332"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtKeypadPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enter Monthly Card Number"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnKeypadCancel"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="✕"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6B2020"
                android:stateListAnimator="@null"
                android:layout_marginEnd="4dp"/>

        </LinearLayout>

        <!-- Card display — centred in the space above the keypad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter the last 6 digits of your card"
                android:textSize="14sp"
                android:textColor="#8B949E"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/txtKeypadDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="_ _ _ _ _ _"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#00AEEF"
                android:gravity="center"
                android:singleLine="true"
                android:letterSpacing="0.1"
                android:padding="12dp"/>

        </LinearLayout>

        <!-- Keypad grid -->
        <GridLayout
            android:id="@+id/keypadGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="8dp"
            android:columnCount="3"
            android:rowCount="4"/>

    </LinearLayout>


    <!-- CONTACTLESS MONTHLY OVERLAY — shown when monthly_input_method = "contactless" -->
    <LinearLayout
        android:id="@+id/contactlessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#EE0D1117"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header — identical to keypad overlay header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1A2332"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtContactlessPrompt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Monthly Card — Contactless"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnContactlessCancel"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:text="✕"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6B2020"
                android:stateListAnimator="@null"
                android:layout_marginEnd="4dp"/>

        </LinearLayout>

        <!-- Body — centred, same visual language as main screen -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- Monthly card icon — same circle_green + 🪪 as the main Monthly button -->
            <LinearLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:gravity="center"
                android:background="@drawable/circle_green"
                android:layout_marginBottom="28dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🪪"
                    android:textSize="40sp"/>
            </LinearLayout>

            <!-- Main message — same style as txtMessage (28sp bold #F0F6FC) -->
            <TextView
                android:id="@+id/txtContactlessStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap your monthly card"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#F0F6FC"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp"/>

            <!-- Subtitle — same style as txtSelectPrompt (16sp #8B949E) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hold the card near the contactless reader"
                android:textSize="16sp"
                android:textColor="#8B949E"
                android:gravity="center"
                android:letterSpacing="0.05"
                android:layout_marginBottom="32dp"/>

            <!-- Spinner — same as main screen progress (36dp #1F6FEB) -->
            <ProgressBar
                android:id="@+id/progressContactless"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="#1F6FEB"/>

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>